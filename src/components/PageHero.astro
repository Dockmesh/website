---
interface Props { kicker: string; title: string; lede?: string }
const { kicker, title, lede } = Astro.props;
---
<div class="phero">
  <div class="dm-wrap">
    <p class="kicker">{kicker}</p>
    <h1><Fragment set:html={title} /></h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>
