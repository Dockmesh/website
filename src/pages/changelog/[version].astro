---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getReleases, inlineMd, type Release } from '../../lib/changelog';
import { LINKS } from '../../data/site';

export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((r) => ({ params: { version: r.version }, props: { r } }));
}
const { r } = Astro.props as { r: Release };
const badge = r.severity !== 'normal' ? ` <span class="badge ${r.severity}">${r.severity}</span>` : '';
---
<Base title={`Dockmesh ${r.version}`} description={r.summary} current="changelog" searchKind="Releases">
  <PageHero kicker={`Changelog · ${r.date}`} title={`Dockmesh ${r.version}${badge}`} lede={r.summary}>
    {r.minUpgrade && <p style="margin:12px 0 0;color:var(--subtle);font-size:14.5px">Upgrades directly from {r.minUpgrade} or later.</p>}
  </PageHero>
  <section class="sec"><div class="dm-wrap prose-dm">
    {r.sections.map((s) => (
      <>
        <h2>{s.title}</h2>
        <ul>{s.items.map((it) => <li set:html={inlineMd(it)} />)}</ul>
      </>
    ))}
    <p style="margin-top:30px"><a href="/changelog/">← All releases</a> · <a href={`${LINKS.releases}/tag/v${r.version}`}>On GitHub</a></p>
  </div></section>
</Base>
